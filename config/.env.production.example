# POLYROB production environment — TEMPLATE. MUST contain NO real secrets.
# GENERATED by scripts/gen_env_templates.py from core/flags_catalog.py — edit the
# generator (or docs/CONFIGURATION.md), not this file.
#   cp config/.env.production.example config/.env.production
# Anything marked CHANGE_ME is required before going live.

# ===========================================
# CORE
# ===========================================
ENVIRONMENT=production
# this instance's id; pin it on a server (the deploy refuses without it)
# POLYROB_INSTANCE_ID=
# the data home OUTSIDE the code tree (host install only; docker reads
# config/.env.example)
POLYROB_DATA_DIR=/var/lib/polyrob
DATA_DIR=/var/lib/polyrob/data
DB_PATH=/var/lib/polyrob/data/bot.db
LOG_LEVEL=INFO

# ===========================================
# API AND CONSOLE
# ===========================================
# bearer token guarding the REST/A2A surface. CHANGE_ME (random)
API_AUTH_TOKEN=
WEBVIEW_HOST=127.0.0.1
WEBVIEW_PORT=5050
# local (default, single owner) | multitenant (hosted signin/profile/admin)
# POLYROB_POSTURE=

# ===========================================
# OWNER
# ===========================================
# the bound owner; autonomous mode clamps to supervised without it
# POLYROB_OWNER_USER_ID=
# the owner's numeric Telegram id
# POLYROB_OWNER_TELEGRAM_ID=

# ===========================================
# BROWSER
# ===========================================
PLAYWRIGHT_BROWSERS_PATH=/var/lib/polyrob/.cache/ms-playwright
BROWSER_HEADLESS=true
MAX_BROWSER_CONTEXTS=25

# ===========================================
# LLM PROVIDER KEYS (at least one) — CHANGE_ME
# ===========================================
# pin the default provider (else key-aware resolution picks one)
# DEFAULT_PROVIDER=
# DEFAULT_MODEL=
OPENAI_API_KEY=
# anthropic and gemini are extras: on a server add them to PROD_EXTRAS
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=POLYROB AI Agent
# NVIDIA NIM (optional)
NVIDIA_API_KEY=
# search (optional)
PERPLEXITY_API_KEY=

# ===========================================
# SURFACES (optional)
# ===========================================
# TELEGRAM_BOT_TOKEN=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BOT_USER_ID=
TWITTER_BOT_USERNAME=

# ===========================================
# CRYPTO (optional — OFF by default)
# ===========================================
ALCHEMY_API_KEY=
COLLABLAND_API_KEY=

# ===========================================
# MEMORY AND MCP
# ===========================================
# sqlite (FTS keyword) | local_vector (needs the [memory-vector] extra) | none
MEMORY_BACKEND=sqlite
# posture members (MCP_ENABLED, KB_ENABLED, …) are set only here or by their bundle
POLYROB_OVERRIDES=MCP_ENABLED=true
# Fernet key encrypting the MCP/OAuth secret store. CHANGE_ME
MCP_ENCRYPTION_KEY=

# ===========================================
# SECURITY / AUTH SECRETS — CHANGE_ME (`openssl rand -hex 32`)
# ===========================================
ENABLE_AUTH=true
JWT_SECRET_KEY=
# deposit derivation seed — changing it changes every derived address
PAYMENT_MASTER_SEED=

# ===========================================
# AUTONOMY (all OFF by default; the easy way: `polyrob autonomy on`)
# ===========================================
# the master switch for the self-directed loops
# AUTONOMY_ENABLED=
# silent | owner-visible | full
# AUTONOMY_POSTURE=
# supervised | autonomous (needs POLYROB_OWNER_USER_ID)
# AUTONOMY_MODE=

# ===========================================
# PUBLIC FLAGS — documented defaults (docs/CONFIGURATION.md); uncomment to change
# ===========================================

# --- LLM / providers ---
# Hard cap on generated output tokens per call (default: 16384)
# LLM_MAX_OUTPUT_TOKENS=
# Path to the user-declared provider file (YAML: `providers:` map of `ProviderSpec` rows
# — base_url/transport/env_key/models/etc) (default: unset (~/.polyrob/providers.yaml))
# LLM_CUSTOM_PROVIDERS=

# --- Autonomy & continuous-learning loops ---
# `0` = confined (today's docker sandbox, no persistent shell) (default: 0)
# AGENT_COMPUTE_POSTURE=
# §3.2 rail memory: max user-bound sends per tenant per rolling 24h (default: 30)
# USER_DELIVERY_DAILY_CAP=
# The ONE step cap for an autonomous run: goal, cron, delegation (`delegate_task`) and
# worker runs (083) (default: 150)
# AUTONOMOUS_MAX_STEPS=
# Max concurrent goal runs (default: 2)
# GOAL_MAX_CONCURRENT=
# Max goal runs started per trailing 24h; <=0 disables (default: 6)
# GOAL_DAILY_QUOTA=
# Legacy facet of the owner pause record — read, never written (default: OFF)
# AUTONOMY_HALT=

# --- Delegation / sub-agents ---
# Enable `delegate_task` / sub-agent delegation (default: **ON** ('true'; BotConfig
# field also True))
# SUB_AGENTS_ENABLED=

# --- Tools / code-exec / cron / approvals ---
# Register `code_execution` tool (NOT a sandbox; never in default tool_ids) (default:
# OFF)
# CODE_EXEC_ENABLED=
# Code-exec backend selector (default: local_subprocess)
# CODE_EXEC_BACKEND=
# The FIFTH named default bundle: `off` = byte-identical; `build` = `PUBLISH_ENABLED` +
# `GITHUB_TOOL_ENABLED` default ON and `publish` joins the autonomous goal toolset;
# `ship` = `build` + `APP_SERVICE_ENABLED` + `APP_SERVICE_ALLOW_PUBLIC` ON and
# `app_service` joins the goal tools (default: off)
# AGENT_BUILDER_MODE=
# Public base URL of the owner-auth webview console (e.g. `https://console.example.com`)
# (default: unset)
# WEBVIEW_PUBLIC_URL=
# Approval provider: `auto`(allow)/`auto_notify`(allow + `tool_auto_approved` audit
# event + post-hoc owner notification — act-and-report)/`deny`/custom
# (`interactive_cli`, `owner_queue` self-register on import) (default: auto)
# APPROVAL_PROVIDER=
# the owner-legible switch for outward payment-creation actions
# (`PAYMENT_APPROVAL_TOOLS`), gated FIRST-CLASS independent of `APPROVAL_REQUIRED_TOOLS`
# (default: approve (auto under AUTONOMY_MODE=autonomous))
# PAYMENT_APPROVAL_MODE=
# Named toolset driving the CLI session's tool list (`resolve_toolset`), same as
# `polyrob run --toolset <name>` (default: unset)
# POLYROB_AGENT_TOOLSET=
# GitHub token for the `github` tool when no per-user OAuth token is stored
# (`GITHUB_TOKEN` wins; the standard gh-CLI/Actions names) (default: unset (secret,
# masked))
# GITHUB_TOKEN=
# Durable hourly attempt cap shared by X API and browser clients across tools and
# workers in the same data home (default: 15)
# TWITTER_WRITE_MAX_PER_HOUR=

# --- API / server / sessions ---
# Mount the OpenAI-compatible `/v1` router (default: OFF)
# OPENAI_COMPAT_API_ENABLED=
# Max agent steps for a chat-surface turn (default: 8)
# CHAT_MAX_STEPS=
# Session-cumulative provider-spend ceiling in USD; when > 0 the run loop halts honestly
# (`run_budget_exhausted`) before the next step once summed `usage_records.api_cost_usd`
# for the session reaches the cap (default: 0 (disabled))
# RUN_BUDGET_USD=
# Per-run provider-spend cap in USD for an autonomous (cron/goal) run (default: 2.0 (0 =
# off))
# AUTONOMOUS_RUN_BUDGET_USD=

# --- Identity / polyrob / local profile ---
# Single-user terminal profile; flips the `_SAFE_LOCAL_FLAGS` group ON as a default
# (default: OFF)
# POLYROB_LOCAL=
# Comma list of raw Telegram numeric user ids allowed to drive the bot (default: unset)
# ALLOWED_TELEGRAM_USER_IDS=
# The owner's email address for out-of-band cron delivery (`deliver="email"`) on single-
# owner headless deploys where no `user_directory` service is registered (default:
# unset)
# POLYROB_OWNER_EMAIL=
# the owner-notice fan-out order for `deliver_user_message` (approvals, credit sentinel,
# goal-blocked, settlement, cron reports) — a comma list of surface ids, primary first
# (e.g. `slack,telegram`) (default: unset (= telegram))
# OWNER_SURFACE=
# the default `chat.mode` for a room with no per-chat overlay (default: mention)
# GROUP_DEFAULT_MODE=
# Transcribe inbound voice/audio to text before routing (#9), so a voice note is handled
# like a typed message (default: ON)
# VOICE_TRANSCRIPTION_ENABLED=
# pure outbound-policy model (`open\ (default: allowlist (open under
# AUTONOMY_MODE=autonomous))
# OUTBOUND_POLICY=
# Control-plane cap on outbound sends/day once policy is `open`/`domains` (mirrors the
# `USER_DELIVERY_DAILY_CAP` convention) (default: 30)
# OUTBOUND_DAILY_SEND_CAP=
# Which transport backs the agent's email: `smtp` \ (default: auto)
# EMAIL_PROVIDER=
# AgentMail (api.agentmail.to) API key (default: unset)
# AGENTMAIL_API_KEY=
# Meta permanent/system-user access token used by the Cloud API sender client (default:
# unset)
# WHATSAPP_ACCESS_TOKEN=
# Feishu / Lark surface credentials: the custom app's App ID (`cli_…`) + App Secret
# (default: unset (secret, masked))
# FEISHU_APP_ID=
# DingTalk surface credentials: the internal app's Client ID (AppKey, also its
# robotCode) + Client Secret (AppSecret) (default: unset (secret, masked))
# DINGTALK_CLIENT_ID=
# Slack surface credentials: bot token (`xoxb-`) + Socket-Mode app token (`xapp-`); both
# required or `polyrob slack` refuses to start (default: unset (secret, masked))
# SLACK_BOT_TOKEN=
# Slack surface credentials: bot token (`xoxb-`) + Socket-Mode app token (`xapp-`); both
# required or `polyrob slack` refuses to start (default: unset (secret, masked))
# SLACK_APP_TOKEN=
# Discord surface bot token (a `--token` CLI option wins over the env) (default: unset
# (secret, masked))
# DISCORD_BOT_TOKEN=
# The Signal account (+E164 number) the surface sends/receives as; required for `polyrob
# signal` (default: unset)
# SIGNAL_ACCOUNT=

# --- Billing / x402 / wallet ---
# Enable x402 pay-per-request *receiving* (default: OFF ('false'))
# X402_ENABLED=
# Hard ceiling on a single agent-created payment request (an absurd invoice is a
# reputation incident) (default: 50)
# X402_INVOICE_MAX_USD=
# Enable the agent's native wallet (default: OFF)
# AGENT_WALLET_ENABLED=
# Wallet network (`testnet`/`mainnet`) (default: testnet)
# AGENT_WALLET_NETWORK=
# Per-transaction USD ceiling (catastrophic-loss guard, NOT a budget) (default: 250)
# AGENT_WALLET_MAX_PER_TX_USD=
# where the agent's signatures come from (default: local)
# WALLET_SIGNER=
# Rolling 24h spend cap (2026-08-22: was unset/disabled — the per-tx ceiling alone
# cannot stop a within-ceiling loop draining the treasury one ticket at a time)
# (default: 100)
# WALLET_DAILY_CAP_USD=

# --- DeFi / on-chain trading ---
# the `defi_trade` tool's EVM money verbs: `transfer`, `approve_token` (exact-amount
# only), `revoke_approval`, `swap` (route seam: local Uniswap V3 first,
# `DEFI_ROUTE_AGGREGATOR` fallback) (default: OFF)
# DEFI_TRADE_ENABLED=
# Default (clamped to 1–1000) slippage bound for `defi_trade.swap`, in basis points (100
# = 1%) (default: 100)
# DEFI_MAX_SLIPPAGE_BPS=
# Per-transaction ceiling below which a `defi_trade` verb may execute autonomously;
# above it `tx_guard` returns `lane=owner_queue` and does NOT execute (default: 25)
# DEFI_AUTONOMOUS_MAX_USD=
# Per-payment ceiling below which an `x402_fetch` skips the owner-approval tap and runs
# act-and-report (default: 1.0)
# X402_AUTONOMOUS_MAX_USD=

# --- WebView / Console (deployment posture, owner login, branding) ---
# Owner login username for `own_ops`/`multitenant` posture (Posture 1/2 console access)
# (default: unset)
# POLYROB_OWNER_USERNAME=
# Argon2 hash of the owner password — never plaintext (default: unset)
# POLYROB_OWNER_PASSWORD_HASH=

# --- Misc / runtime knobs ---
# Override for the polyrob home directory (CLI config, keys, home-migration target)
# (default: ~/.polyrob)
# POLYROB_HOME=
# Named-profile selection (tier 2; the `-P`/`--profile` flag is tier 1 and overwrites
# it) (default: unset)
# POLYROB_PROFILE=
