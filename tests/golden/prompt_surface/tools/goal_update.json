{
  "function": {
    "description": "Edit a goal's title/body/priority/acceptance/tools.",
    "name": "goal_update",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "default": null,
          "description": "What 'done' must prove (ids/paths/urls).",
          "nullable": true,
          "type": "string"
        },
        "body": {
          "default": null,
          "nullable": true,
          "type": "string"
        },
        "goal_id": {
          "type": "string"
        },
        "priority": {
          "default": null,
          "maximum": 10,
          "minimum": 1,
          "nullable": true,
          "type": "integer"
        },
        "tier": {
          "default": null,
          "description": "Optional model tier for this work's runs — from the owner's chat only: 'heavy' for work that decides money (who is paid and how much) or is hard to undo; 'light' for bulk reads; 'default' = the normal model. <environment> names each tier's model. Requires 'why'.",
          "enum": [
            "default",
            "heavy",
            "light"
          ],
          "nullable": true,
          "type": "string"
        },
        "title": {
          "default": null,
          "minLength": 3,
          "nullable": true,
          "type": "string"
        },
        "tools": {
          "default": null,
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "why": {
          "default": null,
          "description": "One line: why this tier. Required with 'tier'; shown in /status.",
          "maxLength": 200,
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "goal_id"
      ],
      "type": "object"
    }
  },
  "type": "function"
}
