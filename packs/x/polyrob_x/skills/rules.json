      "task_patterns": [
        "\\b(find|discover|identify)\\b.*\\b(accounts?|people|targets?|prospects?|conversations?)\\b.*\\b(on x|x\\.com|twitter|social)\\b",
        "\\bwho (to|should (i|we|you)) (engage|reply to|follow)\\b",
